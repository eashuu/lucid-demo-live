# Copy this file to .env.local (same folder as package.json) and fill in your keys.
# .env.local is git-ignored. Restart `npm run dev` after editing it.
# With no keys at all, Lucid runs in DEMO MODE with canned data.
# Model IDs checked 26 Sep 2026. Providers retire models often: if you get a
# "model not found / decommissioned" error, pick a current ID from the provider's docs.

# -- LLM: any OpenAI-compatible provider ------------------------------------
# Groq (free, very fast, no card): https://console.groq.com/keys
# Free tier per model: 30 requests/min, 1,000/day, 8K tokens/min.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Smaller model for related questions + follow-up rewriting (separate rate-limit bucket on Groq).
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# Google Gemini (free tier): https://aistudio.google.com/apikey
# New keys can't use the 2.5 models; use 3.5 Flash-Lite (higher free limits) or 3.8 Flash.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FAST_MODEL=gemini-3.5-flash-lite
# (delete LLM_REASONING_EFFORT or set it to low)

# OpenRouter (free models end in :free, 50 requests/day): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-27b:free
# LLM_FAST_MODEL=qwen/qwen3.8-27b:free

# Ollama (fully offline, runs on your laptop): https://ollama.com
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_FAST_MODEL=llama3.2

# -- Web search --------------------------------------------------------------
# Tavily (free 1,000 searches/month, no card): https://app.tavily.com
TAVILY_API_KEY=
